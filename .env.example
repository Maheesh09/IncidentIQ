# Copy this file to .env and fill in your values
# Never commit .env to git

DATABASE_URL=postgresql+asyncpg://user:password@host/incidentiq?ssl=require
GEMINI_API_KEY=
GITHUB_PAT=
DEFAULT_LOOKBACK_MINUTES=30
MAX_LOG_SIZE_BYTES=10485760
API_KEY_PEPPER=YourRandomPepperValueHere

# CORS - comma-separated list of allowed origins (required in production)
# Example: CORS_ALLOWED_ORIGINS=["https://app.example.com","https://dashboard.example.com"]
CORS_ALLOWED_ORIGINS=[]